{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ember-to-ocean.local/contract/schemas/geo.schema.json",
  "title": "Ember to Ocean - geo.geojson (one per scope)",
  "description": "Polygon / MultiPolygon features with properties.kind. Country scope: one 'country' outline and one clickable 'basin' outline (id = basin id). Basin scope: one 'basin' outline and one 'water' rectangle per water body (id = water body id). The optional top-level 'scope' member ('canada' or 'canada/fraser') switches the per-scope rules on; a scope containing '/' is a basin.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "scope": { "$ref": "#/$defs/scope" },
    "features": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/feature" } }
  },
  "allOf": [
    {
      "if": { "required": ["scope"], "properties": { "scope": { "pattern": "/" } } },
      "then": {
        "properties": {
          "features": {
            "items": { "properties": { "properties": { "properties": { "kind": { "enum": ["basin", "water"] } } } } },
            "allOf": [
              { "contains": { "properties": { "properties": { "properties": { "kind": { "const": "basin" } } } } }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "properties": { "properties": { "kind": { "const": "water" } } } } }, "minContains": 1 }
            ]
          }
        }
      },
      "else": {
        "if": { "required": ["scope"] },
        "then": {
          "properties": {
            "features": {
              "items": { "properties": { "properties": { "properties": { "kind": { "enum": ["country", "basin"] } } } } },
              "allOf": [
                { "contains": { "properties": { "properties": { "properties": { "kind": { "const": "country" } } } } }, "minContains": 1, "maxContains": 1 },
                { "contains": { "properties": { "properties": { "properties": { "kind": { "const": "basin" } } } } }, "minContains": 1, "maxContains": 1 }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "scope": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(/[a-z][a-z0-9_]*)?$" },
    "position": {
      "type": "array",
      "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }],
      "items": false,
      "minItems": 2
    },
    "linearRing": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/position" } },
    "polygonCoordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/linearRing" } },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "oneOf": [
        { "properties": { "type": { "const": "Polygon" }, "coordinates": { "$ref": "#/$defs/polygonCoordinates" } } },
        { "properties": { "type": { "const": "MultiPolygon" }, "coordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/polygonCoordinates" } } } }
      ]
    },
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": { "$ref": "#/$defs/geometry" },
        "properties": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["country", "basin", "water"] },
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 }
          },
          "if": { "properties": { "kind": { "enum": ["basin", "water"] } } },
          "then": { "required": ["kind", "id", "name"] }
        }
      }
    }
  }
}
