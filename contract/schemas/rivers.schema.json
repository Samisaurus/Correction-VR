{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ember-to-ocean.local/contract/schemas/rivers.schema.json",
  "title": "Ember to Ocean - rivers.geojson (one per scope)",
  "description": "LineString features. order is the stream order 1-9 (HydroRIVERS ORD_STRA, or 10 - scalerank for Natural Earth). nearFire lists the years in which a fire cell lay within 50 km (country scope) or 25 km (basin scope) of the segment.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "scope": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(/[a-z][a-z0-9_]*)?$" },
    "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
  },
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }],
      "items": false,
      "minItems": 2
    },
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "LineString" },
            "coordinates": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } }
          }
        },
        "properties": {
          "type": "object",
          "required": ["id", "name", "order", "nearFire"],
          "properties": {
            "id": { "type": ["integer", "string"] },
            "name": { "type": ["string", "null"] },
            "order": { "type": "integer", "minimum": 1, "maximum": 9 },
            "nearFire": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 2012, "maximum": 2025 }
            }
          }
        }
      }
    }
  }
}
