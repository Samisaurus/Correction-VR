{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ember-to-ocean.local/contract/schemas/air.schema.json",
  "title": "Ember to Ocean - air/<year>.geojson (one per scope and year)",
  "description": "One Polygon per air cell inside the scope (2.0 x 2.5 degree blocks in country scope, native 0.5 x 0.625 MERRA-2 cells in basin scope). aod = May-Sep mean aerosol optical depth at 550 nm; pm25 = May-Sep mean surface PM2.5 (ug/m3) or null.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "scope": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(/[a-z][a-z0-9_]*)?$" },
    "year": { "type": "integer", "minimum": 2012, "maximum": 2025 },
    "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
  },
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }],
      "items": false,
      "minItems": 2
    },
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/position" } } }
          }
        },
        "properties": {
          "type": "object",
          "required": ["aod", "pm25"],
          "properties": {
            "aod": { "type": "number", "minimum": 0 },
            "pm25": { "type": ["number", "null"], "minimum": 0 }
          }
        }
      }
    }
  }
}
