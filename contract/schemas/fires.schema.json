{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ember-to-ocean.local/contract/schemas/fires.schema.json",
  "title": "Ember to Ocean - fires/<year>.geojson (one per scope and year)",
  "description": "One Point per grid cell with fires that year (0.5 degree cells in country scope, 0.1 degree in basin scope); the point is the cell centre. count = detections, frp_sum = summed fire radiative power (MW), first / last = first and last detection date.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "scope": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(/[a-z][a-z0-9_]*)?$" },
    "year": { "type": "integer", "minimum": 2012, "maximum": 2025 },
    "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Point" },
            "coordinates": {
              "type": "array",
              "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }],
              "items": false,
              "minItems": 2
            }
          }
        },
        "properties": {
          "type": "object",
          "required": ["count", "frp_sum", "first", "last"],
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "frp_sum": { "type": "number", "minimum": 0 },
            "first": { "$ref": "#/$defs/date" },
            "last": { "$ref": "#/$defs/date" }
          }
        }
      }
    }
  }
}
